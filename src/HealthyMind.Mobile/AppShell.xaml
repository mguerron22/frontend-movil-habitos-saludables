<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="HealthyMind.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:HealthyMind.Mobile.Views"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False">

    <!-- Pantallas de acceso: sin pestañas. Startup decide a cuál ir. -->
    <ShellContent Route="startup" ContentTemplate="{DataTemplate views:StartupPage}" />
    <ShellContent Route="login" ContentTemplate="{DataTemplate views:LoginPage}" />
    <ShellContent Route="unlock" ContentTemplate="{DataTemplate views:UnlockPage}" />

    <!-- App principal: las 5 pestañas del mock. -->
    <TabBar Route="main">
        <ShellContent Title="Inicio" Icon="tab_home.png" Route="home" ContentTemplate="{DataTemplate views:HomePage}" />
        <ShellContent Title="Hábitos" Icon="tab_habits.png" Route="habits" ContentTemplate="{DataTemplate views:HabitsPage}" />
        <ShellContent Title="Stats" Icon="tab_stats.png" Route="stats" ContentTemplate="{DataTemplate views:StatsPage}" />
        <ShellContent Title="IA" Icon="tab_ai.png" Route="insights" ContentTemplate="{DataTemplate views:InsightsPage}" />
        <ShellContent Title="Perfil" Icon="tab_profile.png" Route="profile" ContentTemplate="{DataTemplate views:ProfilePage}" />
    </TabBar>
</Shell>
