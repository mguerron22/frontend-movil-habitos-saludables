<?xml version="1.0" encoding="utf-8" ?>
<!-- Dispositivos con la sesión abierta. -->
<ContentPage
    x:Class="HealthyMind.Mobile.Views.SessionsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:HealthyMind.Mobile.Controls"
    xmlns:vm="clr-namespace:HealthyMind.Mobile.Core.ViewModels;assembly=HealthyMind.Mobile.Core"
    x:DataType="vm:SessionsViewModel"
    Shell.TabBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,32" Spacing="18">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <ImageButton Source="ic_arrow_left.png" WidthRequest="44" HeightRequest="44" Padding="10" CornerRadius="22"
                             BackgroundColor="{StaticResource Surface}" Command="{Binding GoBackCommand}" SemanticProperties.Description="Volver" />
                <Label Grid.Column="1" Text="Mis dispositivos" Style="{StaticResource Title}" VerticalOptions="Center" />
            </Grid>

            <controls:OfflineBanner Margin="-20,0" />

            <Label Text="Aquí ves dónde está abierta tu cuenta. Si no reconoces un dispositivo, cierra su sesión y cambia tu contraseña."
                   Style="{StaticResource Body}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Primary}" />

            <Border Style="{StaticResource ErrorBox}" IsVisible="{Binding HasError}">
                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" FontSize="13" />
            </Border>

            <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Sessions}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:DeviceSession">
                        <Border Style="{StaticResource Card}" Padding="16,14">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 14" StrokeThickness="0" BackgroundColor="{StaticResource MintSoft}">
                                    <Image Source="ic_fingerprint.png" WidthRequest="22" HeightRequest="22" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="15" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="12" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="Cerrar" Style="{StaticResource Link}" TextColor="{StaticResource Danger}" VerticalOptions="Center"
                                       IsVisible="{Binding IsCurrent, Converter={StaticResource Not}}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding RevokeCommand, Source={RelativeSource AncestorType={x:Type vm:SessionsViewModel}}, x:DataType=vm:SessionsViewModel}"
                                            CommandParameter="{Binding .}" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Border Grid.Column="2" Style="{StaticResource Chip}" IsVisible="{Binding IsCurrent}" Padding="10,4" VerticalOptions="Center">
                                    <Label Text="Actual" Style="{StaticResource ChipText}" FontSize="12" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Button Style="{StaticResource DangerButton}" Text="Cerrar sesión en los demás" Command="{Binding RevokeOthersCommand}"
                    IsVisible="{Binding HasOthers}" IsEnabled="{Binding IsNotBusy}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
