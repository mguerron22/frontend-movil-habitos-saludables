<?xml version="1.0" encoding="utf-8" ?>
<!-- Pestaña reservada: la construye la mitad 2 del frontend. -->
<ContentPage
    x:Class="HealthyMind.Mobile.Views.StatsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:HealthyMind.Mobile.Controls">

    <Grid RowDefinitions="Auto,Auto,*">
        <controls:AppHeader x:Name="Header" Section="Estadísticas" />
        <controls:OfflineBanner Grid.Row="1" />

        <VerticalStackLayout Grid.Row="2" Padding="20,16" Spacing="16">
            <Label Text="Tu progreso" Style="{StaticResource Display}" FontSize="28" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Image Source="tab_stats.png" WidthRequest="32" HeightRequest="32" HorizontalOptions="Start" />
                    <Label Text="Consistencia global, ritmo semanal y distribución por dimensión de tus hábitos." Style="{StaticResource Body}" />
                    <Border Style="{StaticResource Chip}">
                        <Label Text="En construcción · Mitad 2" Style="{StaticResource ChipText}" />
                    </Border>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
