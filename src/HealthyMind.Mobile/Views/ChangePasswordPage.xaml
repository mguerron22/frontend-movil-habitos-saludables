<?xml version="1.0" encoding="utf-8" ?>
<!-- Cambiar contraseña: cierra la sesión en los demás dispositivos y conserva la de este. -->
<ContentPage
    x:Class="HealthyMind.Mobile.Views.ChangePasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:HealthyMind.Mobile.Controls"
    xmlns:vm="clr-namespace:HealthyMind.Mobile.Core.ViewModels;assembly=HealthyMind.Mobile.Core"
    x:DataType="vm:ChangePasswordViewModel"
    Shell.TabBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,32" Spacing="18">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <ImageButton Source="ic_arrow_left.png" WidthRequest="44" HeightRequest="44" Padding="10" CornerRadius="22"
                             BackgroundColor="{StaticResource Surface}" Command="{Binding CancelCommand}" SemanticProperties.Description="Volver" />
                <Label Grid.Column="1" Text="Cambiar contraseña" Style="{StaticResource Title}" VerticalOptions="Center" />
            </Grid>

            <controls:OfflineBanner Margin="-20,0" />

            <Border Style="{StaticResource Card}" Padding="20,22">
                <VerticalStackLayout Spacing="16">
                    <controls:FormField Label="Contraseña actual" Icon="ic_lock.png" Placeholder="Tu contraseña de hoy"
                                        IsPassword="{Binding IsPasswordHidden}" Text="{Binding CurrentPassword}" Error="{Binding CurrentPasswordError}" />
                    <controls:FormField Label="Nueva contraseña" Icon="ic_key.png" Placeholder="Mínimo 8, con mayúscula y número"
                                        IsPassword="{Binding IsPasswordHidden}" Text="{Binding NewPassword}" Error="{Binding NewPasswordError}" />
                    <controls:FormField Label="Confirmar nueva contraseña" Icon="ic_key.png" Placeholder="Repite la nueva contraseña"
                                        IsPassword="{Binding IsPasswordHidden}" Text="{Binding ConfirmPassword}" Error="{Binding ConfirmPasswordError}" />

                    <HorizontalStackLayout Spacing="6">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding TogglePasswordVisibilityCommand}" />
                        </HorizontalStackLayout.GestureRecognizers>
                        <Image WidthRequest="18" HeightRequest="18">
                            <Image.Triggers>
                                <DataTrigger TargetType="Image" Binding="{Binding IsPasswordHidden}" Value="True">
                                    <Setter Property="Source" Value="ic_eye.png" />
                                </DataTrigger>
                                <DataTrigger TargetType="Image" Binding="{Binding IsPasswordHidden}" Value="False">
                                    <Setter Property="Source" Value="ic_eye_off.png" />
                                </DataTrigger>
                            </Image.Triggers>
                        </Image>
                        <Label Style="{StaticResource Caption}" Text="Mostrar contraseñas" />
                    </HorizontalStackLayout>

                    <Border Style="{StaticResource ErrorBox}" IsVisible="{Binding HasError}">
                        <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" FontSize="13" />
                    </Border>

                    <Grid>
                        <Button Style="{StaticResource PrimaryButton}" Text="Cambiar contraseña" Command="{Binding SaveCommand}" IsEnabled="{Binding IsNotBusy}" />
                        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource OnPrimary}"
                                           WidthRequest="24" HeightRequest="24" HorizontalOptions="End" Margin="0,0,20,0" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource SoftCard}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Image Source="ic_shield.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Start" />
                    <Label Grid.Column="1" Style="{StaticResource Body}"
                           Text="Al cambiarla se cierra tu sesión en los demás dispositivos. La entrada con huella de este teléfono sigue funcionando." />
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
