<?xml version="1.0" encoding="utf-8" ?>
<!-- Perfil (RF01): datos, cuenta, huella, administración y cerrar sesión. -->
<ContentPage
    x:Class="HealthyMind.Mobile.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:HealthyMind.Mobile.Controls"
    xmlns:vm="clr-namespace:HealthyMind.Mobile.Core.ViewModels;assembly=HealthyMind.Mobile.Core"
    x:DataType="vm:ProfileViewModel">

    <Grid RowDefinitions="Auto,Auto,*">
        <controls:AppHeader Section="Perfil" Initials="{Binding Initials}" />
        <controls:OfflineBanner Grid.Row="1" />

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="20,12,20,32" Spacing="18">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Border Style="{StaticResource Avatar}" WidthRequest="84" HeightRequest="84" HorizontalOptions="Center">
                            <Label Text="{Binding Initials}" Style="{StaticResource AvatarText}" FontSize="28" />
                        </Border>
                        <Label Text="{Binding FullName}" Style="{StaticResource Title}" HorizontalOptions="Center" />
                        <Label Text="{Binding Username}" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                        <Label Text="{Binding Email}" Style="{StaticResource Body}" HorizontalOptions="Center" />
                        <Border Style="{StaticResource Chip}" HorizontalOptions="Center" IsVisible="{Binding IsAdmin}">
                            <Label Text="Administrador" Style="{StaticResource ChipText}" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Cuenta" Style="{StaticResource Subtitle}" />
                <Border Style="{StaticResource Card}" Padding="18,4">
                    <VerticalStackLayout>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="0,12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding EditProfileCommand}" />
                        </Grid.GestureRecognizers>
                        <Border WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="{StaticResource MintSoft}">
                            <Image Source="ic_user_teal.png" WidthRequest="20" HeightRequest="20" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                            <Label Text="Editar perfil" FontFamily="OpenSansSemibold" />
                            <Label Text="Nombre, apellido y correo" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                        <Image Grid.Column="2" Source="ic_chevron_right.png" WidthRequest="18" HeightRequest="18" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource Divider}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="0,12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChangePasswordCommand}" />
                        </Grid.GestureRecognizers>
                        <Border WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="{StaticResource MintSoft}">
                            <Image Source="ic_key.png" WidthRequest="20" HeightRequest="20" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                            <Label Text="Cambiar contraseña" FontFamily="OpenSansSemibold" />
                            <Label Text="Cierra la sesión en otros dispositivos" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                        <Image Grid.Column="2" Source="ic_chevron_right.png" WidthRequest="18" HeightRequest="18" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource Divider}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="0,12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SessionsCommand}" />
                        </Grid.GestureRecognizers>
                        <Border WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="{StaticResource MintSoft}">
                            <Image Source="ic_shield.png" WidthRequest="20" HeightRequest="20" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                            <Label Text="Mis dispositivos" FontFamily="OpenSansSemibold" />
                            <Label Text="Dónde está abierta tu cuenta" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                        <Image Grid.Column="2" Source="ic_chevron_right.png" WidthRequest="18" HeightRequest="18" />
                    </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" Padding="18,4" IsVisible="{Binding IsAdmin}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="0,12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AdminUsersCommand}" />
                        </Grid.GestureRecognizers>
                        <Border WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="{StaticResource MintSoft}">
                            <Image Source="ic_server.png" WidthRequest="20" HeightRequest="20" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                            <Label Text="Administrar usuarios" FontFamily="OpenSansSemibold" />
                            <Label Text="Buscar, suspender y reactivar cuentas" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                        <Image Grid.Column="2" Source="ic_chevron_right.png" WidthRequest="18" HeightRequest="18" />
                    </Grid>
                </Border>

                <Label Text="Seguridad" Style="{StaticResource Subtitle}" />
                <Border Style="{StaticResource Card}" Padding="18,14">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Image Source="ic_fingerprint.png" WidthRequest="30" HeightRequest="30" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Entrar con huella" FontFamily="OpenSansSemibold" />
                            <Label Style="{StaticResource Caption}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsBiometricAvailable}" Value="True">
                                        <Setter Property="Text" Value="No volverás a escribir tu contraseña en este teléfono." />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsBiometricAvailable}" Value="False">
                                        <Setter Property="Text" Value="Registra una huella en los ajustes del teléfono para activarla." />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>
                        <Switch
                            Grid.Column="2"
                            IsToggled="{Binding IsBiometricEnabled}"
                            IsEnabled="{Binding IsBiometricAvailable}"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Padding="18,14">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Image Source="ic_map_pin.png" WidthRequest="28" HeightRequest="28" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Guardar ubicación" FontFamily="OpenSansSemibold" />
                            <Label Text="Anota dónde registras cada hábito. Es opcional y solo lo ves tú." Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="2" IsToggled="{Binding IsLocationEnabled}" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Padding="18,14">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Image Source="ic_bell.png" WidthRequest="28" HeightRequest="28" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Modo presentación" FontFamily="OpenSansSemibold" />
                            <Label Text="La IA te escribe cada 3 minutos para mostrar las notificaciones. Apágalo al terminar." Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="2" IsToggled="{Binding IsPresentationEnabled}" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource ErrorBox}" IsVisible="{Binding HasError}">
                    <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" FontSize="13" />
                </Border>

                <Button
                    Style="{StaticResource DangerButton}"
                    Text="Cerrar sesión"
                    ImageSource="ic_logout.png"
                    ContentLayout="Left,8"
                    Command="{Binding LogoutCommand}"
                    IsEnabled="{Binding IsNotBusy}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
