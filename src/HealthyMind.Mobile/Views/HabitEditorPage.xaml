<?xml version="1.0" encoding="utf-8" ?>
<!-- Crear o editar un hábito (RF02). -->
<ContentPage
    x:Class="HealthyMind.Mobile.Views.HabitEditorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:HealthyMind.Mobile.Controls"
    xmlns:vm="clr-namespace:HealthyMind.Mobile.Core.ViewModels;assembly=HealthyMind.Mobile.Core"
    x:DataType="vm:HabitEditorViewModel"
    Shell.TabBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,32" Spacing="18">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <ImageButton
                    Source="ic_arrow_left.png"
                    WidthRequest="44"
                    HeightRequest="44"
                    Padding="10"
                    CornerRadius="22"
                    BackgroundColor="{StaticResource Surface}"
                    Command="{Binding CancelCommand}"
                    SemanticProperties.Description="Volver" />
                <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource Title}" VerticalOptions="Center" />
            </Grid>

            <controls:OfflineBanner Margin="-20,0" />

            <Border Style="{StaticResource Card}" Padding="20,22">
                <VerticalStackLayout Spacing="16">
                    <controls:FormField
                        Label="Nombre del hábito"
                        Icon="ic_leaf.png"
                        Placeholder="Tomar agua"
                        Text="{Binding Name}"
                        Error="{Binding NameError}" />

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Categoría" Style="{StaticResource FieldLabel}" />
                        <FlexLayout Wrap="Wrap" JustifyContent="Start" BindableLayout.ItemsSource="{Binding Categories}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:CategoryOption">
                                    <Border Margin="0,0,8,8" StrokeThickness="1.5" Stroke="Transparent" StrokeShape="RoundRectangle 14" Padding="10,7"
                                            BackgroundColor="{Binding Info.TileColor, Converter={StaticResource HexColor}}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding SelectCategoryCommand, Source={RelativeSource AncestorType={x:Type vm:HabitEditorViewModel}}, x:DataType=vm:HabitEditorViewModel}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <HorizontalStackLayout Spacing="6">
                                            <Image Source="{Binding Info.Icon}" WidthRequest="18" HeightRequest="18" />
                                            <Label Text="{Binding Info.Name}" FontSize="14" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>

                    <!-- Cómo se mide: a mano o con el contador de pasos del teléfono (RF06); solo en Ejercicio -->
                    <Border Style="{StaticResource SoftCard}" Padding="14,10" IsVisible="{Binding CanCountSteps}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Image Source="ic_steps.png" WidthRequest="22" HeightRequest="22" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Contar pasos automáticamente" FontFamily="OpenSansSemibold" FontSize="14" />
                                <Label Text="Usa el contador de pasos del teléfono." Style="{StaticResource Caption}" FontSize="12" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="2" IsToggled="{Binding UsesStepCounter}" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <controls:FormField
                            Label="Meta diaria"
                            Icon="ic_target.png"
                            Placeholder="8"
                            Keyboard="Numeric"
                            Text="{Binding Goal}"
                            Error="{Binding GoalError}" />
                        <controls:FormField
                            Grid.Column="1"
                            Label="Unidad"
                            Icon="ic_target.png"
                            Placeholder="vasos"
                            Text="{Binding Unit}"
                            Error="{Binding UnitError}" />
                    </Grid>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Días" Style="{StaticResource FieldLabel}" />
                        <!-- Los 7 días se reparten el ancho: en teléfonos angostos el domingo no se sale de la pantalla -->
                        <FlexLayout JustifyContent="SpaceBetween" BindableLayout.ItemsSource="{Binding Days}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:DayOption">
                                    <Border WidthRequest="36" HeightRequest="36" StrokeThickness="0" StrokeShape="Ellipse" BackgroundColor="{StaticResource InputBackground}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding ToggleDayCommand, Source={RelativeSource AncestorType={x:Type vm:HabitEditorViewModel}}, x:DataType=vm:HabitEditorViewModel}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="{Binding Letter}" FontFamily="OpenSansSemibold" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{StaticResource TextSecondary}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource OnPrimary}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>

                    <Border Style="{StaticResource ErrorBox}" IsVisible="{Binding HasError}">
                        <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" FontSize="13" />
                    </Border>

                    <Button Style="{StaticResource PrimaryButton}" Text="{Binding SaveText}" Command="{Binding SaveCommand}" IsEnabled="{Binding IsNotBusy}" />
                </VerticalStackLayout>
            </Border>

            <!-- Solo al editar -->
            <VerticalStackLayout Spacing="10" IsVisible="{Binding IsEditing}">
                <Button Style="{StaticResource SoftButton}" Text="{Binding PauseText}" Command="{Binding TogglePauseCommand}" />
                <Button Style="{StaticResource DangerButton}" Text="Eliminar hábito" ImageSource="ic_trash.png" ContentLayout="Left,8"
                        Command="{Binding DeleteCommand}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
