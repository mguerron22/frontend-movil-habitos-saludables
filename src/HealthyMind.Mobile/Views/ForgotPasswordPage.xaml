<?xml version="1.0" encoding="utf-8" ?>
<!-- Recuperar contraseña: 1) correo → llega un código; 2) código + contraseña nueva. -->
<ContentPage
    x:Class="HealthyMind.Mobile.Views.ForgotPasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:HealthyMind.Mobile.Controls"
    xmlns:vm="clr-namespace:HealthyMind.Mobile.Core.ViewModels;assembly=HealthyMind.Mobile.Core"
    x:DataType="vm:ForgotPasswordViewModel"
    Shell.TabBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,32" Spacing="18">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <ImageButton Source="ic_arrow_left.png" WidthRequest="44" HeightRequest="44" Padding="10" CornerRadius="22"
                             BackgroundColor="{StaticResource Surface}" Command="{Binding GoBackCommand}" SemanticProperties.Description="Volver" />
                <Label Grid.Column="1" Text="Recuperar contraseña" Style="{StaticResource Title}" VerticalOptions="Center" />
            </Grid>

            <controls:OfflineBanner Margin="-20,0" />

            <!-- Paso 1: correo -->
            <Border Style="{StaticResource Card}" Padding="20,22" IsVisible="{Binding IsAskingEmail}">
                <VerticalStackLayout Spacing="16">
                    <Label Style="{StaticResource Body}" Text="Escribe el correo de tu cuenta. Te enviaremos un código de 6 dígitos para poner una contraseña nueva." />
                    <controls:FormField Label="Correo electrónico" Icon="ic_mail.png" Placeholder="tu@correo.com" Keyboard="Email"
                                        Text="{Binding Email}" Error="{Binding EmailError}" />

                    <Border Style="{StaticResource ErrorBox}" IsVisible="{Binding HasError}">
                        <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" FontSize="13" />
                    </Border>

                    <Grid>
                        <Button Style="{StaticResource PrimaryButton}" Text="Enviar código" Command="{Binding SendCodeCommand}" IsEnabled="{Binding IsNotBusy}" />
                        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource OnPrimary}"
                                           WidthRequest="24" HeightRequest="24" HorizontalOptions="End" Margin="0,0,20,0" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Paso 2: código y contraseña nueva -->
            <Border Style="{StaticResource Card}" Padding="20,22" IsVisible="{Binding CodeSent}">
                <VerticalStackLayout Spacing="16">
                    <Label Style="{StaticResource Body}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Si " />
                                <Span Text="{Binding Email}" FontFamily="OpenSansSemibold" TextColor="{StaticResource PrimaryDark}" />
                                <Span Text=" tiene cuenta, ya te llegó un código (vence en 15 minutos)." />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <controls:FormField Label="Código del correo" Icon="ic_shield.png" Placeholder="000000" Keyboard="Numeric"
                                        Text="{Binding Code}" Error="{Binding CodeError}" />
                    <controls:FormField Label="Nueva contraseña" Icon="ic_key.png" Placeholder="Mínimo 8: mayúscula, minúscula y número"
                                        IsPassword="{Binding IsPasswordHidden}" Text="{Binding NewPassword}" Error="{Binding PasswordError}" />
                    <controls:FormField Label="Confirmar contraseña" Icon="ic_key.png" Placeholder="Repite la nueva contraseña"
                                        IsPassword="{Binding IsPasswordHidden}" Text="{Binding ConfirmPassword}" Error="{Binding ConfirmPasswordError}" />

                    <HorizontalStackLayout Spacing="6">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding TogglePasswordVisibilityCommand}" />
                        </HorizontalStackLayout.GestureRecognizers>
                        <Image WidthRequest="18" HeightRequest="18">
                            <Image.Triggers>
                                <DataTrigger TargetType="Image" Binding="{Binding IsPasswordHidden}" Value="True">
                                    <Setter Property="Source" Value="ic_eye.png" />
                                </DataTrigger>
                                <DataTrigger TargetType="Image" Binding="{Binding IsPasswordHidden}" Value="False">
                                    <Setter Property="Source" Value="ic_eye_off.png" />
                                </DataTrigger>
                            </Image.Triggers>
                        </Image>
                        <Label Style="{StaticResource Caption}" Text="Mostrar contraseñas" />
                    </HorizontalStackLayout>

                    <Border Style="{StaticResource ErrorBox}" IsVisible="{Binding HasError}">
                        <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" FontSize="13" />
                    </Border>

                    <Grid>
                        <Button Style="{StaticResource PrimaryButton}" Text="Cambiar contraseña" Command="{Binding ResetCommand}" IsEnabled="{Binding IsNotBusy}" />
                        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource OnPrimary}"
                                           WidthRequest="24" HeightRequest="24" HorizontalOptions="End" Margin="0,0,20,0" />
                    </Grid>

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="18">
                        <Label Text="Reenviar código" Style="{StaticResource Link}" FontSize="14">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SendCodeCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Label Text="Cambiar correo" Style="{StaticResource Link}" FontSize="14">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeEmailCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource SoftCard}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Image Source="ic_lock.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Start" />
                    <Label Grid.Column="1" Style="{StaticResource Body}"
                           Text="Al cambiarla se cierra tu sesión en todos los dispositivos. Si tu cuenta estaba bloqueada por intentos fallidos, queda desbloqueada." />
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
