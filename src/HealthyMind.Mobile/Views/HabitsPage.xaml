<?xml version="1.0" encoding="utf-8" ?>
<!-- Pestaña Hábitos (RF02): todos los hábitos con filtro por categoría; tocar uno abre el editor. -->
<ContentPage
    x:Class="HealthyMind.Mobile.Views.HabitsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:HealthyMind.Mobile.Controls"
    xmlns:vm="clr-namespace:HealthyMind.Mobile.Core.ViewModels;assembly=HealthyMind.Mobile.Core"
    x:DataType="vm:HabitsViewModel">

    <Grid RowDefinitions="Auto,Auto,*">
        <controls:AppHeader Section="Hábitos" Initials="{Binding Initials}" />
        <controls:OfflineBanner Grid.Row="1" />

        <RefreshView
            Grid.Row="2"
            Command="{Binding RefreshCommand}"
            IsRefreshing="{Binding IsRefreshing}"
            RefreshColor="{StaticResource Primary}">
            <ScrollView>
                <VerticalStackLayout Padding="20,8,20,110" Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Mis hábitos" Style="{StaticResource Display}" FontSize="28" />
                            <Label Text="{Binding Summary}" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                        <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="End">
                            <Label Text="Ver pausados" Style="{StaticResource Caption}" VerticalOptions="Center" />
                            <Switch IsToggled="{Binding ShowPaused}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- Filtro por categoría -->
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="-20,0">
                        <HorizontalStackLayout Padding="20,0" Spacing="8" BindableLayout.ItemsSource="{Binding Filters}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:CategoryFilter">
                                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="14,7" BackgroundColor="{StaticResource Surface}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding SelectFilterCommand, Source={RelativeSource AncestorType={x:Type vm:HabitsViewModel}}, x:DataType=vm:HabitsViewModel}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="{Binding Name}" FontSize="14" FontFamily="OpenSansSemibold" TextColor="{StaticResource TextSecondary}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource OnPrimary}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <Border Style="{StaticResource Card}" IsVisible="{Binding IsEmpty}">
                        <VerticalStackLayout Spacing="10">
                            <Image Source="ic_leaf.png" WidthRequest="32" HeightRequest="32" HorizontalOptions="Start" />
                            <Label Text="No hay hábitos aquí" Style="{StaticResource Subtitle}" />
                            <Label Text="Toca + para crear uno nuevo." Style="{StaticResource Body}" />
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Habits}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:HabitListItem">
                                <Border Style="{StaticResource Card}" Padding="14">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type vm:HabitsViewModel}}, x:DataType=vm:HabitsViewModel}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsPaused}" Value="True">
                                            <Setter Property="Opacity" Value="0.6" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                        <Border WidthRequest="52" HeightRequest="52" StrokeThickness="0" StrokeShape="RoundRectangle 16"
                                                BackgroundColor="{Binding Category.TileColor, Converter={StaticResource HexColor}}" VerticalOptions="Center">
                                            <Image Source="{Binding Category.Icon}" WidthRequest="26" HeightRequest="26" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                            <HorizontalStackLayout Spacing="8">
                                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="8,2"
                                                        BackgroundColor="{Binding Category.ChipColor, Converter={StaticResource HexColor}}">
                                                    <Label Text="{Binding Category.Name}" FontSize="12"
                                                           TextColor="{Binding Category.ChipTextColor, Converter={StaticResource HexColor}}" />
                                                </Border>
                                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="8,2"
                                                        BackgroundColor="{StaticResource WarningSoft}" IsVisible="{Binding IsPaused}">
                                                    <Label Text="Pausado" FontSize="12" TextColor="{StaticResource Warning}" />
                                                </Border>
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding Name}" FontSize="17" FontFamily="OpenSansSemibold" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                            <HorizontalStackLayout Spacing="4">
                                                <Image Source="ic_target.png" WidthRequest="14" HeightRequest="14" />
                                                <Label Text="{Binding GoalText}" Style="{StaticResource Caption}" />
                                                <Label Text="·" Style="{StaticResource Caption}" />
                                                <Label Text="{Binding DaysText}" Style="{StaticResource Caption}" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <Image Grid.Column="2" Source="ic_chevron_right.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <Button
            Grid.Row="2"
            Text="+"
            FontSize="30"
            TextColor="{StaticResource PrimaryDark}"
            BackgroundColor="{StaticResource Mint}"
            WidthRequest="60"
            HeightRequest="60"
            CornerRadius="30"
            Padding="0"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="0,0,20,20"
            Command="{Binding AddCommand}"
            SemanticProperties.Description="Nuevo hábito" />
    </Grid>
</ContentPage>
