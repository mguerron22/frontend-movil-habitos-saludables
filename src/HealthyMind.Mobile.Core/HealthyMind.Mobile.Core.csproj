<Project Sdk="Microsoft.NET.Sdk">

  <!-- Lógica de la app sin dependencias de MAUI: se prueba con xUnit sin emulador. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- CA1515: tipos públicos a propósito (los consume el proyecto MAUI). CA2007: no hay contexto de sincronización que evitar en ViewModels. -->
    <NoWarn>$(NoWarn);CA1515;CA1062;CA1848;CA1873;CA2007;CA1031;CA1032;CA1716;CA1056;CA1054</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HealthyMind.Mobile.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
  </ItemGroup>

</Project>
